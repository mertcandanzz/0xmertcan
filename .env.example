# ── Database ───────────────────────────────────────────────
# Local: `docker compose up -d` starts PostgreSQL with these defaults.
DATABASE_URL=postgres://oxm:oxm_local_dev@127.0.0.1:5432/oxmertcan

# ── Payload ────────────────────────────────────────────────
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# ── Site ───────────────────────────────────────────────────
# Public origin used for canonical URLs, sitemap, RSS and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional: S3-compatible media storage (production) ─────
# Leave empty to store uploads on local disk (./media).
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Optional: seed an admin account (npm run seed) ─────────
# Never commit real values. If empty, create the first admin at /admin.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── GitHub: admin sign-in + repo sync ──────────────────────
# Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:      = NEXT_PUBLIC_SITE_URL
#   Callback URL:      <NEXT_PUBLIC_SITE_URL>/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub usernames allowed into /admin (empty = nobody via GitHub).
ADMIN_GITHUB_LOGINS=
# true → request the `repo` scope so private repositories are synced too (as drafts).
GITHUB_INCLUDE_PRIVATE=false
# Optional fallbacks for sync without GitHub sign-in (public repos only without a token).
GITHUB_USERNAME=
GITHUB_TOKEN=
